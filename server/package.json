{
  "name": "eventpulse-server",
  "version": "1.0.0",
  "description": "Backend API and WebSocket server for EventPulse",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node \"../node_modules/tsx/dist/cli.mjs\" watch src/index.ts",
